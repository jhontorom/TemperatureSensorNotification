# Copy this file to a secure environment file outside the repository and fill in real values.
# Example: /etc/room-monitor.env
ROOM_MONITOR_TELEGRAM_BOT_TOKEN="replace-with-bot-token"
ROOM_MONITOR_AUTHORIZED_CHAT_ID="123456789"
ROOM_MONITOR_I2C_BUS="1"
ROOM_MONITOR_I2C_ADDRESS="0x40"
ROOM_MONITOR_LOG_LEVEL="INFO"
ROOM_MONITOR_ALERT_STATE_FILE="/var/lib/room-monitor/alert-state.json"
